# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# --- Database (choose ONE of the two setups below) ---

# Option A: Supabase (hosted Postgres + pgvector, easiest to start with)
# Get this from Supabase project settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Option B: Local PostgreSQL via CLI/psql
# DATABASE_URL=postgresql://kaziforce_user:kaziforce_pass@localhost:5432/kaziforce

# --- App config ---
FLASK_ENV=development
FLASK_APP=kaziforce_api.app
SECRET_KEY=change-me-in-real-env

# --- Sentence-transformers model ---
SENTENCE_MODEL_NAME=all-MiniLM-L6-v2

# --- LLM API for vocabulary discovery (fill in whichever provider you use) ---
LLM_API_KEY=


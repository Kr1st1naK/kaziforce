# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# --- Database (choose ONE of the two setups below) ---

# Option A: Supabase (hosted Postgres, easiest to start with)
# Get this from Supabase project settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Option B: Local PostgreSQL via CLI/psql
# DATABASE_URL=postgresql://kaziforce_user:kaziforce_pass@localhost:5432/kaziforce

# --- App config ---
FLASK_ENV=development
FLASK_APP=kaziforce_api.app
SECRET_KEY=change-me-in-real-env

# --- Environment and keys (docs/privacy-and-keys.md) ---
# "development" or "test" may run without the keys below, with a warning; anything else, or nothing
# at all, is production, where the app refuses to start without the keys and KAZIFORCE_CORS_ORIGIN.
KAZIFORCE_ENV=development

# Phone numbers and workers' names are encrypted with the first key and looked up by the second.
# Generate both lines with:  python -m kaziforce_api.crypto
# Never commit real values, never reuse them across environments, and back them up apart from the
# database: losing a key loses the data it protects.
KAZIFORCE_FIELD_KEY=
KAZIFORCE_PHONE_HMAC_KEY=

# The web app's origin(s), comma-separated, for CORS. Required in production; never *.
# Development defaults to http://localhost:3000 and http://127.0.0.1:3000.
KAZIFORCE_CORS_ORIGIN=

# The sentence-transformer model and revision are pinned in
# apps/api/src/kaziforce_api/matching/semantic.py, not configured here.

# --- LLM API for vocabulary discovery (fill in whichever provider you use) ---
LLM_API_KEY=


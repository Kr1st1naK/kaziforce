# Environments
venv/
.venv/
env/
__pycache__/
*.pyc

# Secrets
.env

# Data (raw data tracked via README pointers, not committed directly —
# see data/README.md. Remove specific lines below if you DO want small files tracked.)
data/raw/**/*.csv
data/raw/**/*.json
data/raw/**/*.jsonl
# The synthetic dataset is small, generated and frozen (splits, ground truth): track it.
!data/raw/synthetic/**/*.csv
!data/raw/synthetic/*.json
!data/**/README.md
!data/**/.gitkeep

# Model artifacts / caches
*.pt
*.bin
.cache/
huggingface/

# OS / editor
.DS_Store
.vscode/
.idea/

# Python packaging
*.egg-info/
build/
dist/

# Web app (apps/web)
node_modules/
.next/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Local agent tooling (BMAD installed per machine; skills hard-code {project-root}/_bmad,
# so the folders stay at the top level but are not published)
.claude/skills/
_bmad/
_bmad-output/

# Course handouts from the supervisor: never commit to this public repo
docs/course/

# Partial evaluation runs (scripts/evaluate.py --max-queries); full runs in results/dev/ are committed
results/scratch/
.claude/
